#include <iostream>
using namespace std;

#define SIZE 5

int stackArr[SIZE];
int top = -1;

void push(int value) {
    if (top == SIZE - 1)
        cout << "Stack Overflow\n";
    else
        stackArr[++top] = value;
}

void pop() {
    if (top == -1)
        cout << "Stack Underflow\n";
    else
        cout << "Deleted: " << stackArr[top--] << endl;
}

void display() {
    for (int i = top; i >= 0; i--)
        cout << stackArr[i] << " ";
    cout << endl;
}

int main() {
    push(10);
    push(20);
    push(30);

    cout << "Stack: ";
    display();

    pop();

    cout << "After pop: ";
    display();

    return 0;
}